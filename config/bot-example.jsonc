{
    //* Application ID
    "app_id": "",

    //* Token
    "token": "",

    //* Language (supported: auto, en, tr)
    "language": "auto",

    //* Log Level (debug [16] > error [8] > warn [4] > info [2] > log [1] > off [0]) [default: debug (if NODE_ENV is not production)]
    "log_level": 16,

    //* Settings
    "clear_old_commands_on_startup": true,

    //* Management (for bot-specific operations like update status, send error logs and etc.)
    "management": {
        "channel_id": "",
        "guild_id": "",
        "user_id": "",
    },

    //* Health endpoint (HTTP server exposing /health, /health/live, /health/ready for probes)
    "health": {
        //* Enable the health HTTP endpoint (useful for Kubernetes/Docker probes)
        "enabled": true,
        //* Port the health HTTP server listens on
        "port": 3000,
    },
}
